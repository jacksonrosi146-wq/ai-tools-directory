---
import Layout from '../../layouts/Layout.astro';
import { tools } from '../../data/tools';

export async function getStaticPaths() {
  return tools.map((tool) => ({
    params: { slug: tool.slug },
    props: { tool },
  }));
}
const { tool } = Astro.props;
---
<Layout title={tool.title} description={tool.desc} image={tool.image}>
    <div class="max-w-4xl mx-auto px-4 py-12">
        <div class="flex items-center gap-6 mb-10">
            <img src={tool.image} class="w-24 h-24 rounded-2xl" />
            <h1 class="text-4xl font-black">{tool.name} Review</h1>
        </div>
        <div class="bg-white p-8 rounded-3xl shadow-sm border mb-10">
            <h2 class="text-2xl font-bold mb-4 text-blue-700">What is {tool.name}?</h2>
            <p class="text-lg leading-relaxed">{tool.desc}</p>
        </div>
        <h2 class="text-2xl font-bold mb-4">How To Use {tool.name}</h2>
        <div class="bg-blue-50 p-6 rounded-xl mb-10 border-l-8 border-blue-600 whitespace-pre-line">{tool.howToUse}</div>
        <h2 class="text-2xl font-bold mb-4">Pricing</h2>
        <p class="text-xl font-bold text-green-600 mb-10">{tool.pricing}</p>
    </div>
</Layout>
