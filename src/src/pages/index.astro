---
import Layout from '../layouts/Layout.astro';
import { tools } from '../data/tools';
---
<Layout title="Best AI Tools 2024 | Directory & Reviews" description="Find the best AI software for writing, video, and more.">
    <main class="max-w-6xl mx-auto px-4 py-16">
        <h1 class="text-5xl font-extrabold text-center mb-4">Discover the Best <span class="text-blue-600">AI Tools</span></h1>
        <p class="text-center text-gray-600 mb-12 text-xl italic">Professional Guide with SEO Insights</p>
        <div class="grid md:grid-cols-3 gap-8">
            {tools.map((tool) => (
                <div class="bg-white p-6 rounded-2xl shadow-md border hover:shadow-xl transition">
                    <img src={tool.image} alt={tool.name} class="w-16 h-16 mb-4"/>
                    <h2 class="text-2xl font-bold mb-2">{tool.name}</h2>
                    <p class="text-gray-600 mb-4">{tool.desc}</p>
                    <a href={`/tools/${tool.slug}`} class="text-blue-600 font-bold border-b-2 border-blue-600">Full Guide →</a>
                </div>
            ))}
        </div>
    </main>
</Layout>
